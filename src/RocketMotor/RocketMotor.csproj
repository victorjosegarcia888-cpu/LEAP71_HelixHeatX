<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PicoGKGeometry>false</PicoGKGeometry>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Ex_RocketMotorChamber.cs" />
    <Compile Include="Ex_RocketMotorNozzle.cs" />
    <Compile Include="Ex_RocketMotorInjector.cs" />
    <Compile Include="Ex_RocketMotorTurbopump.cs" />
    <Compile Include="Ex_RocketMotorPreburner.cs" />
    <Compile Include="Ex_RocketMotorCoolingChannels.cs" />
    <Compile Include="Ex_RocketMotorLattice.cs" />
    <Compile Include="Ex_RocketMotorAssembly.cs" />
    <Compile Include="Ex_RocketMotorAssembly_WithCooling.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(PicoGKGeometry)' == 'true'">
    <Compile Include="../../BodyCentreLattice.cs" />
    <Compile Include="../../BoundaryBeamThickness.cs" />
    <Compile Include="../../CellBasedBeamThickness.cs" />
    <Compile Include="../../ConstantBeamThickness.cs" />
    <Compile Include="../../ConformalCellArray.cs" />
    <Compile Include="../../CuboidCell.cs" />
    <Compile Include="../../GlobalFuncBeamThickness.cs" />
    <Compile Include="../../OctahedronLattice.cs" />
    <Compile Include="../../RandomSplineLattice.cs" />
    <Compile Include="../../RegularCellArray.cs" />
    <Compile Include="../../libs/LEAP71_ShapeKernel/ShapeKernel/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(PicoGKGeometry)' == 'true'">
    <ProjectReference Include="../../libs/PicoGK/PicoGK.csproj" />
  </ItemGroup>
</Project>
